    {
      "id": "82a39f5d-d65e-47d8-b5fa-7003f49c5afa",
      "name": "Klant bepalen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        -120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ev = $('Event lezen & controleren').first().json;\nlet id = ev.mb_contact_id;\nif (!id && $('MoneyBird: factuur ophalen').isExecuted) id = String($('MoneyBird: factuur ophalen').first().json.contact_id || '');\nif (!id) throw new Error('Geen MoneyBird-contact te bepalen voor event ' + ev.action + ' (' + ev.entity_type + ' ' + ev.entity_id + '). Het event staat in c4_event_log op received.');\nreturn [{ json: { mb_contact_id: id, aanleiding: ev.action, event_key: ev.idempotency_key } }];"
      }
    },
