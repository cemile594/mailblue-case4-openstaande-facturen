    {
      "id": "32030f57-8757-414a-ab39-84f22628f9d9",
      "name": "Al verwerkt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        -80
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ ['processed', 'ignored'].includes($json.status) || ($json.status === 'received' && (Date.now() - new Date($json.received_at).getTime()) < 10 * 60 * 1000) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": false,
        "options": {}
      },
      "notes": "Al gedaan = processed/ignored, of received van < 10 min geleden (wordt nu verwerkt). Staat hij langer op received, dan is de vorige poging gecrasht en verwerken we hem opnieuw."
    },
