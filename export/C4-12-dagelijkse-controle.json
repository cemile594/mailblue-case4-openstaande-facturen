    {
      "id": "ee8a10de-3186-489e-9e63-286426369da8",
      "name": "Te controleren klanten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst rows = n => $(n).all().map(i => i.json).filter(r => r && r.id !== undefined);\nconst vervallen = ($('MoneyBird: vervallen facturen').first().json.body || [])\n  .filter(i => !i.original_sales_invoice_id && Number(i.total_unpaid) > 0);\nconst grens = Date.now() - cfg.vastgelopen_na_minuten * 60 * 1000;\nconst vast = rows('Events op received').filter(e => e.received_at && new Date(e.received_at).getTime() < grens);\nconst bron = {};\nconst voeg = (id, waarom) => { if (!id) return; (bron[id] = bron[id] || new Set()).add(waarom); };\nfor (const i of vervallen) voeg(i.contact_id, 'vervallen factuur in MoneyBird');\nfor (const d of rows('Actieve dossiers')) voeg(d.mb_contact_id, 'actief dossier');\nfor (const e of vast) voeg(e.mb_contact_id, 'vastgelopen event');\nreturn Object.entries(bron).map(([id, w]) => ({ json: { mb_contact_id: id, aanleiding: 'dagcontrole', event_key: '', waarom: [...w].join(' + ') } }));"
      },
      "alwaysOutputData": true,
      "notes": "Unie van: klanten met vervallen facturen (MoneyBird) + actieve dossiers + klanten van vastgelopen events. Eén item per klant."
    },
